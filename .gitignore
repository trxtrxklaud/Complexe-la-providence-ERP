# ── Environment ────────────────────────
.env
.env.local
.env.*.local
# نسخ الاحتياط اليدوية تحمل كلمات المرور ومفاتيح التطبيق
.env.bak*
.env.backup*
.env.save
.env.old
auth.json

# ── Dependencies ─────────────────────
/node_modules
/vendor

# ── Build output ─────────────────────
/public/build
/public/hot
/public/storage

# ── Framework cache (مولّدة محليّاً — لا تُلتزم أبداً) ──────────
# إن التُزِمت، وجد أي جهاز قائمة مزوّدين مطبوخة على جهاز آخر فأخفق الإقلاع
/bootstrap/cache/*.php

# ── Storage / runtime ───────────────────
/storage/*.key
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*
!/storage/framework/cache/.gitignore
!/storage/framework/sessions/.gitignore
!/storage/framework/views/.gitignore
!/storage/logs/.gitignore

# ── Local databases (never commit real data) ──────────────
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
/database/database.sqlite
/database/backup-*.sqlite
/providence

# ── Archives ────────────────────────
*.zip
*.tar.gz

# ── IDE / OS ────────────────────────
.idea
.vscode
*.swp
.DS_Store
Thumbs.db

# ── Logs / misc ───────────────────────
npm-debug.log
yarn-error.log
*.log
Homestead.json
Homestead.yaml
Alarms/
.phpunit.cache

.env.testing
