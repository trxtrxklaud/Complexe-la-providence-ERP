# ── Environment ───────────────────────────────────────────
.env
.env.local
.env.*.local
auth.json

# ── Dependencies ─────────────────────────────────────────
/node_modules
/vendor

# ── Build output ─────────────────────────────────────────
/public/build
/public/hot
/public/storage

# ── Storage / runtime ────────────────────────────────────
/storage/*.key
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*
!/storage/framework/cache/.gitignore
!/storage/framework/sessions/.gitignore
!/storage/framework/views/.gitignore
!/storage/logs/.gitignore

# ── Local databases (never commit real data) ──────────────────
*.sqlite
*.sqlite3
/database/database.sqlite
/providence

# ── Archives ───────────────────────────────────────────
*.zip
*.tar.gz

# ── IDE / OS ───────────────────────────────────────────
.idea
.vscode
*.swp
.DS_Store
Thumbs.db

# ── Logs / misc ────────────────────────────────────────
npm-debug.log
yarn-error.log
*.log
Homestead.json
Homestead.yaml
Alarms/
