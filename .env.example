APP_NAME="مركب العناية للتعليم الخاص"
APP_ENV=local
APP_KEY=
# APP_DEBUG=true للتطوير فقط — اجعلها false في أي بيئة يصلها مستخدم حقيقي
APP_DEBUG=true
# المنطقة الزمنية لازمة لصحة دفتر اليوميات: مع UTC تُحسب حركات ما بعد الحادية عشرة ليلاً في اليوم السابق
APP_TIMEZONE=Africa/Tunis
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=providence
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# نطاق الجلسة للكوكيز - اتركه null للتطوير المحلي (localhost / 127.0.0.1)
SESSION_DOMAIN=null

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:8000,127.0.0.1:5173,::1
SANCTUM_TOKEN_EXPIRATION=720

# CORS - قائمة نطاقات مفصولة بفواصل. فارغ = رفض كل المصادر الخارجية
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000
CORS_SUPPORTS_CREDENTIALS=true

# الأدوار التي تتجاوز فحص الصلاحيات التفصيلي
PERMISSION_SUPER_ROLES=admin

# غيّرها قبل أول تشغيل لـ db:seed
ADMIN_DEFAULT_PASSWORD=
